<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kshitij Yadav — Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --blue-deep: #0a1628;
    --blue-dark: #0d2144;
    --blue-mid: #1a4480;
    --blue-bright: #2563eb;
    --blue-light: #60a5fa;
    --blue-pale: #dbeafe;
    --cyan: #06b6d4;
    --teal: #0d9488;
    --amber: #f59e0b;
    --rose: #f43f5e;
    --white: #ffffff;
    --off-white: #f0f6ff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Outfit', sans-serif;
    background: var(--blue-deep);
    color: var(--white);
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0a1628 0%, #0d2144 50%, #0f2f60 100%);
  }

  .hero-bg {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 20% 20%, rgba(37,99,235,0.25) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(6,182,212,0.2) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(96,165,250,0.08) 0%, transparent 70%);
  }

  .grid-lines {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(96,165,250,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96,165,250,0.06) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .floating-shapes {
    position: absolute; inset: 0; pointer-events: none;
  }
  .shape {
    position: absolute;
    border-radius: 50%;
    animation: floatShape 8s ease-in-out infinite;
  }
  .shape-1 { width: 300px; height: 300px; top: -100px; right: -80px; background: radial-gradient(circle, rgba(37,99,235,0.3), transparent 70%); animation-delay: 0s; }
  .shape-2 { width: 200px; height: 200px; bottom: 10%; left: 5%; background: radial-gradient(circle, rgba(6,182,212,0.25), transparent 70%); animation-delay: -3s; }
  .shape-3 { width: 150px; height: 150px; top: 40%; right: 10%; background: radial-gradient(circle, rgba(244,63,94,0.2), transparent 70%); animation-delay: -5s; }

  @keyframes floatShape {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }

  .hero-content {
    position: relative; z-index: 2;
    text-align: center;
    padding: 2rem;
    animation: heroIn 1s ease-out both;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 18px;
    border: 1px solid rgba(96,165,250,0.4);
    border-radius: 30px;
    font-size: 13px; font-weight: 500;
    color: var(--blue-light);
    background: rgba(37,99,235,0.1);
    margin-bottom: 2rem;
    animation: heroIn 1s ease-out 0.2s both;
  }
  .hero-badge .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #22c55e;
    animation: blink 1.8s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .hero-name {
    font-family: 'Syne', sans-serif;
    font-size: clamp(48px, 8vw, 90px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 1rem;
    animation: heroIn 1s ease-out 0.1s both;
  }
  .hero-name span {
    background: linear-gradient(135deg, var(--blue-light), var(--cyan), var(--blue-bright));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: clamp(16px, 2.5vw, 22px);
    font-weight: 300;
    color: rgba(255,255,255,0.65);
    margin-bottom: 2rem;
    animation: heroIn 1s ease-out 0.3s both;
  }

  .hero-chips {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;
    margin-bottom: 2.5rem;
    animation: heroIn 1s ease-out 0.4s both;
  }
  .hero-chip {
    padding: 8px 20px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(96,165,250,0.2);
    border-radius: 30px;
    font-size: 14px;
    color: rgba(255,255,255,0.75);
  }

  .hero-cta {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
    animation: heroIn 1s ease-out 0.5s both;
  }
  .btn-primary {
    padding: 14px 32px;
    background: linear-gradient(135deg, var(--blue-bright), var(--cyan));
    border: none; border-radius: 50px;
    color: white; font-family: 'Outfit', sans-serif;
    font-size: 15px; font-weight: 600;
    cursor: pointer; text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 8px 30px rgba(37,99,235,0.4);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(37,99,235,0.5); }
  .btn-outline {
    padding: 14px 32px;
    background: transparent;
    border: 1px solid rgba(96,165,250,0.4);
    border-radius: 50px;
    color: var(--blue-light);
    font-family: 'Outfit', sans-serif;
    font-size: 15px; font-weight: 500;
    cursor: pointer; text-decoration: none;
    transition: all 0.2s;
  }
  .btn-outline:hover { background: rgba(96,165,250,0.1); border-color: var(--blue-light); }

  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: rgba(255,255,255,0.35); font-size: 12px; letter-spacing: 2px;
    animation: bounce 2s ease-in-out infinite;
  }
  .scroll-hint svg { width: 20px; height: 20px; }
  @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }

  /* ── SECTIONS ── */
  section { padding: 6rem 2rem; max-width: 1100px; margin: 0 auto; }

  .section-label {
    display: flex; align-items: center; gap: 12px;
    font-size: 12px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; color: var(--cyan);
    margin-bottom: 1rem;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(6,182,212,0.4), transparent);
  }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700; line-height: 1.1;
    margin-bottom: 3rem;
  }
  .section-title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--blue-light), var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── WORK EXPERIENCE ── */
  .work-card {
    background: linear-gradient(135deg, rgba(26,68,128,0.4), rgba(13,33,68,0.6));
    border: 1px solid rgba(96,165,250,0.2);
    border-radius: 20px;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s;
  }
  .work-card:hover { transform: translateY(-4px); border-color: rgba(96,165,250,0.5); }
  .work-card::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--blue-bright), var(--cyan), var(--teal));
  }
  .work-tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 14px;
    background: rgba(34,197,94,0.15);
    border: 1px solid rgba(34,197,94,0.3);
    border-radius: 20px;
    font-size: 12px; font-weight: 600;
    color: #4ade80; margin-bottom: 1.25rem;
  }
  .work-tag .dot { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; animation: blink 1.8s infinite; }
  .work-role { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .work-org { font-size: 16px; color: var(--blue-light); font-weight: 500; margin-bottom: 0.5rem; }
  .work-date { font-size: 13px; color: rgba(255,255,255,0.45); margin-bottom: 1.5rem; }
  .work-points { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .work-points li {
    display: flex; gap: 12px; align-items: flex-start;
    font-size: 15px; color: rgba(255,255,255,0.75); line-height: 1.6;
  }
  .work-points li::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--cyan); margin-top: 8px; flex-shrink: 0;
  }

  /* ── SKILLS ── */
  .skills-section { background: rgba(13,33,68,0.4); border-radius: 24px; padding: 3rem; margin-bottom: 2rem; }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .skill-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(96,165,250,0.15);
    border-radius: 16px; padding: 1.5rem;
    transition: all 0.3s;
  }
  .skill-card:hover { background: rgba(37,99,235,0.1); border-color: rgba(96,165,250,0.4); transform: translateY(-3px); }
  .skill-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; margin-bottom: 1rem;
  }
  .skill-name { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 10px; }
  .skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .skill-tag {
    padding: 4px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 500;
    background: rgba(96,165,250,0.1);
    border: 1px solid rgba(96,165,250,0.2);
    color: var(--blue-light);
  }
  .typing-bar { margin-top: 10px; }
  .typing-label { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 6px; display: flex; justify-content: space-between; }
  .bar-track { height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--blue-bright), var(--cyan)); animation: barGrow 1.5s ease-out both; }
  @keyframes barGrow { from { width: 0; } }

  /* ── EDUCATION ── */
  .edu-timeline { position: relative; padding-left: 2rem; }
  .edu-timeline::before {
    content: ''; position: absolute; left: 6px; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--blue-bright), var(--cyan), transparent);
  }
  .edu-item {
    position: relative; margin-bottom: 2.5rem;
    animation: fadeSlide 0.6s ease-out both;
  }
  .edu-item::before {
    content: ''; position: absolute;
    left: -2rem; top: 6px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--blue-bright);
    border: 3px solid var(--blue-deep);
    box-shadow: 0 0 12px rgba(37,99,235,0.6);
  }
  @keyframes fadeSlide { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }
  .edu-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(96,165,250,0.15);
    border-radius: 16px; padding: 1.5rem;
    transition: all 0.3s;
  }
  .edu-card:hover { background: rgba(37,99,235,0.08); border-color: rgba(96,165,250,0.35); }
  .edu-year { font-size: 12px; font-weight: 600; color: var(--cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 6px; }
  .edu-degree { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; margin-bottom: 4px; }
  .edu-inst { font-size: 14px; color: rgba(255,255,255,0.55); margin-bottom: 8px; }
  .edu-score {
    display: inline-block; padding: 4px 14px;
    background: linear-gradient(135deg, rgba(37,99,235,0.3), rgba(6,182,212,0.2));
    border: 1px solid rgba(96,165,250,0.3);
    border-radius: 20px; font-size: 13px; font-weight: 600; color: var(--blue-light);
  }

  /* ── CERTIFICATIONS ── */
  .cert-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .cert-card {
    background: linear-gradient(135deg, rgba(245,158,11,0.1), rgba(251,191,36,0.05));
    border: 1px solid rgba(245,158,11,0.25);
    border-radius: 16px; padding: 1.5rem;
    transition: all 0.3s;
  }
  .cert-card:hover { transform: translateY(-3px); border-color: rgba(245,158,11,0.5); }
  .cert-icon { font-size: 28px; margin-bottom: 10px; }
  .cert-name { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #fcd34d; margin-bottom: 6px; }
  .cert-by { font-size: 13px; color: rgba(255,255,255,0.5); }

  /* ── PROJECT ── */
  .project-card {
    background: linear-gradient(135deg, rgba(13,148,136,0.15), rgba(6,182,212,0.08));
    border: 1px solid rgba(13,148,136,0.3);
    border-radius: 20px; padding: 2.5rem;
    position: relative; overflow: hidden;
    transition: all 0.3s;
  }
  .project-card:hover { transform: translateY(-4px); border-color: rgba(13,148,136,0.5); }
  .project-card::after {
    content: '';
    position: absolute; top: -60px; right: -60px;
    width: 200px; height: 200px; border-radius: 50%;
    background: radial-gradient(circle, rgba(6,182,212,0.15), transparent 70%);
  }
  .proj-label { font-size: 12px; font-weight: 600; color: var(--teal); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; }
  .proj-name { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; margin-bottom: 8px; }
  .proj-tech { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.25rem; }
  .proj-tech span {
    padding: 4px 12px; border-radius: 20px;
    font-size: 12px; background: rgba(13,148,136,0.2);
    border: 1px solid rgba(13,148,136,0.3); color: #5eead4;
  }
  .proj-desc { font-size: 15px; color: rgba(255,255,255,0.7); line-height: 1.7; }

  /* ── ABOUT / PERSONAL ── */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 600px) { .about-grid { grid-template-columns: 1fr; } }
  .about-item {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(96,165,250,0.12);
    border-radius: 14px; padding: 1.25rem;
  }
  .about-label { font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--blue-light); margin-bottom: 6px; }
  .about-value { font-size: 15px; font-weight: 500; }

  /* ── STRENGTHS ── */
  .strengths-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .strength-pill {
    padding: 12px 24px;
    background: linear-gradient(135deg, rgba(37,99,235,0.2), rgba(6,182,212,0.1));
    border: 1px solid rgba(96,165,250,0.25);
    border-radius: 50px; font-size: 15px; font-weight: 500;
    transition: all 0.3s; cursor: default;
  }
  .strength-pill:hover { background: linear-gradient(135deg, rgba(37,99,235,0.4), rgba(6,182,212,0.2)); transform: scale(1.05); }

  /* ── EXTRA CURRICULAR ── */
  .extra-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .extra-grid { grid-template-columns: 1fr; } }
  .extra-card {
    background: linear-gradient(135deg, rgba(244,63,94,0.08), rgba(251,113,133,0.04));
    border: 1px solid rgba(244,63,94,0.2);
    border-radius: 16px; padding: 1.5rem;
    transition: all 0.3s;
  }
  .extra-card:hover { border-color: rgba(244,63,94,0.4); transform: translateY(-3px); }
  .extra-icon { font-size: 26px; margin-bottom: 10px; }
  .extra-text { font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.65; }

  /* ── CONTACT ── */
  .contact-section {
    background: linear-gradient(135deg, rgba(26,68,128,0.5), rgba(13,33,68,0.8));
    border: 1px solid rgba(96,165,250,0.2);
    border-radius: 24px; padding: 3rem;
    text-align: center;
  }
  .contact-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 2rem; }
  .contact-link {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 24px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(96,165,250,0.2);
    border-radius: 50px; text-decoration: none;
    color: rgba(255,255,255,0.8); font-size: 14px; font-weight: 500;
    transition: all 0.3s;
  }
  .contact-link:hover { background: rgba(37,99,235,0.2); border-color: var(--blue-light); color: white; }

  /* ── FOOTER ── */
  footer {
    text-align: center; padding: 2rem;
    font-size: 13px; color: rgba(255,255,255,0.25);
    border-top: 1px solid rgba(96,165,250,0.1);
  }

  /* ── DIVIDER ── */
  .divider {
    max-width: 1100px; margin: 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(96,165,250,0.2), transparent);
  }

  @media (max-width: 700px) {
    section { padding: 4rem 1.25rem; }
    .skills-section { padding: 1.5rem; }
    .work-card, .project-card, .contact-section { padding: 1.5rem; }
  }
</style>
</head>
